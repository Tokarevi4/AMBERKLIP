<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_printer"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:id="@+id/printerForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/printer_name"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/nameEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:hint="@string/printer_name"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_dialog_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/moonraker_address"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/hostEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:hint="@string/ip_or_local_domain"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_dialog_input" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/portEdit"
                android:layout_width="78dp"
                android:layout_height="48dp"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:hint="@string/port"
                android:inputType="number"
                android:gravity="center"
                android:maxLength="5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_dialog_input" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/moonraker_api_key"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/apiKeyEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:hint="@string/api_key"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_dialog_input" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/scanQrButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/scan_api_key_qr"
                android:src="@android:drawable/ic_menu_camera"
                android:background="@drawable/bg_dialog_input" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/deleteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:includeFontPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dialogButtons"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="0dp">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/actionButton"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:text="@string/add_printer"
            android:textColor="@color/background"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_dialog_button" />

    </LinearLayout>

</LinearLayout>
